  "question_templates": {
    "F01_RECENT_NEW_ACCOUNTS": {
      "type": "number",
      "title": "过去 24 个月，你本人作为主卡人新开了几张信用卡？",
      "description": "计算 Chase 5/24。主要看个人信用报告里的新账户；只做副卡的账户请在下一题单独填写。",
      "min": 0,
      "max": 30,
      "count_bands": [
        {
          "value": 0,
          "label": "0–3 张"
        },
        {
          "value": 4,
          "label": "4 张"
        },
        {
          "value": 5,
          "label": "5 张或更多"
        }
      ]
    },
    "F06_AU_BREAKDOWN": {
      "type": "number",
      "title": "过去 24 个月新增的信用卡副卡账户，有没有还在你的信用报告上的？",
      "description": "接近 5/24 边界时，副卡可能也被系统计入；是否可以人工排除没有保证。",
      "min": 0,
      "max": 30,
      "count_bands": [
        {
          "value": 0,
          "label": "没有"
        },
        {
          "value": 1,
          "label": "有（至少 1 张）"
        }
      ],
      "visible_when": {
        "fact": "F01_RECENT_NEW_ACCOUNTS",
        "equals": 4
      }
    },
    "F02_ISSUER_APPLICATION_HISTORY": {
      "type": "structured",
      "title": "最近 30 天，你在 Chase 的获批情况",
      "description": "这里只问已经获批的 Chase 卡，没批的不计入。",
      "fields": [
        {
          "id": "approved_chase_30d",
          "type": "number",
          "label": "过去 30 天，你获批了几张 Chase 信用卡？",
          "min": 0,
          "max": 30,
          "rule_ids": [
            "CHASE-002"
          ],
          "count_bands": [
            {
              "value": 0,
              "label": "0–1 张"
            },
            {
              "value": 2,
              "label": "2 张或更多"
            }
          ]
        },
        {
          "id": "approved_chase_business_30d",
          "type": "single",
          "label": "过去 30 天，你有 Chase 商业信用卡获批吗？",
          "options": [
            {
              "value": "NO",
              "label": "没有"
            },
            {
              "value": "YES",
              "label": "有"
            }
          ],
          "rule_ids": [
            "CHASE-012"
          ]
        }
      ]
    },
    "F03_CARD_HISTORY": {
      "type": "multi",
      "title": "下面这些卡，你现在还持有哪些？",
      "description": "只勾选目前还没有关掉的卡；如果问的是过去办卡经历，页面会特别说明。",
      "allow_none": true
    },
    "F04_BONUS_HISTORY": {
      "type": "multi",
      "title": "你曾拿过以下哪些卡的新卡开卡奖励？",
      "description": "如果问的是过去 24 个月，时间以实际拿到奖励的日期为准。",
      "allow_none": true
    }
  },
  "default_offer_note": "按已审核的公开开卡奖励规则进行模拟，具体以当前申请链接的条款为准。"
